# Committed template - NO real secret values. Your real .env (gitignored) fills these in.
# The DB password and JWT signing keys are NOT here - they load from Secrets Manager at runtime.
AWS_ENDPOINT=http://localhost.floci.io:4566
# Floci local AWS emulator; real AWS endpoint/configuration in deployment.
AWS_REGION=us-east-1
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taxpulse
DB_USER=taxpulse_app
DB_SSL=disable

# SecretId references (names in Secrets Manager), not the secret values themselves:
DB_SECRET_ID=taxpulse/db-password
JWT_SECRET_ID=taxpulse/jwt-signing-keys
SECRETS_REFRESH_MS=300000
