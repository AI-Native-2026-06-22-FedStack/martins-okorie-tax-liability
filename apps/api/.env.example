# TaxPulse API service environment
# Copy to `apps/api/.env` for local API-only runs. Docker Compose supplies container values directly.

PORT=3000
NODE_ENV=development

# Database
DATABASE_URI=postgresql://taxpulse_app@localhost:55433/taxpulse_l
TAXPULSE_TEST_DATABASE_URL=postgresql://taxpulse_app@localhost:55433/taxpulse_l
DB_HOST=localhost
DB_PORT=55433
DB_NAME=taxpulse_l
DB_USER=taxpulse_app
DB_SSL=disable
DB_SECRET_ID=taxpulse/db-password

# Authentication and cryptography
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
JWT_ISSUER=taxpulse-api
JWT_AUDIENCE=taxpulse-clients
JWT_SECRET_ID=taxpulse/jwt-signing-keys
MFA_ENCRYPTION_KEY=replace-with-local-64-char-hex-key

# Service dependencies
COMPUTE_SERVICE_URL=http://localhost:8001
TIVS_ACL_BASE_URL=http://localhost:4300
SPA_CLOUDFRONT_ORIGIN=http://E8QHBU60URLFRL.cloudfront.localhost.localstack.cloud:4566

# Local AWS emulator and read model
AWS_ENDPOINT=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SECRETS_REFRESH_MS=300000
DDB_ENDPOINT=http://localhost:4566
DDB_TABLE_NAME=taxpulse-plan-cycle-read-model
STAGE_CHANGED_TOPIC=taxpulse-stage-changed
STAGE_CHANGED_QUEUE=taxpulse-stage-changed-projection
STAGE_CHANGED_DLQ=taxpulse-stage-changed-dlq

# Caches, rate limits, and idempotency
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
QUEUE_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_MS=30000
