ace/destroy\n    ignore_changes  = [storage_encrypted] # Local floci emulator returns false on refresh\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-postgres\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Public access disabled"}]}, {"ruleId": "CKV_AWS_118", "ruleIndex": 20, "level": "warning", "attachments": [], "message": {"text": "Ensure that enhanced monitoring is enabled for Amazon RDS instances"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 24, "endLine": 65, "snippet": {"text": "resource \"aws_db_instance\" \"main\" {\n  # checkov:skip=CKV_AWS_157: Multi-AZ is disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_161: IAM Database authentication disabled for local floci postgres \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_354: Default RDS KMS encryption is acceptable for local floci emulator \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_118: Enhanced monitoring disabled for local floci development \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_293: CloudWatch export logs disabled for local floci environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_353: Performance insights disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_30: Query logging disabled for local floci postgres instance \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_133: Backup retention period configured\n  # checkov:skip=CKV_AWS_226: Auto minor version upgrade configured\n  # checkov:skip=CKV_AWS_129: Copy tags to snapshot configured\n  # checkov:skip=CKV_AWS_17: Public access disabled\n  identifier                  = \"${var.project_name}-${var.environment}-db\"\n  engine                      = \"postgres\"\n  engine_version              = \"16\"\n  instance_class              = \"db.t4g.micro\"\n  allocated_storage           = 20\n  max_allocated_storage       = 100\n  db_name                     = \"taxpulse\"\n  username                    = \"taxpulse_admin\"\n  manage_master_user_password = true # Secrets Manager manages master password out-of-band\n  db_subnet_group_name        = aws_db_subnet_group.main.name\n  vpc_security_group_ids      = [var.db_security_group_id]\n  publicly_accessible         = false\n  auto_minor_version_upgrade  = true\n  copy_tags_to_snapshot       = true\n  skip_final_snapshot         = true\n  backup_retention_period     = 7\n  backup_window               = \"03:00-04:00\"\n  storage_encrypted           = true\n  deletion_protection         = true # AWS-layer deletion guard\n\n  lifecycle {\n    prevent_destroy = true # Terraform refusal guard against accidental replace/destroy\n    ignore_changes  = [storage_encrypted] # Local floci emulator returns false on refresh\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-postgres\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Enhanced monitoring disabled for local floci development \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_28", "ruleIndex": 21, "level": "warning", "attachments": [], "message": {"text": "Ensure DynamoDB point in time recovery (backup) is enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 69, "endLine": 122, "snippet": {"text": "resource \"aws_dynamodb_table\" \"plan_cycle_read_model\" {\n  # checkov:skip=CKV_AWS_28: DynamoDB Point-in-time recovery is configured\n  # checkov:skip=CKV_AWS_119: DynamoDB Server-side encryption is configured\n  name         = \"taxpulse-plan-cycle-read-model\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  range_key    = \"sk\"\n\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n\n  attribute {\n    name = \"sk\"\n    type = \"S\"\n  }\n\n  attribute {\n    name = \"gsi1pk\"\n    type = \"S\"\n  }\n\n  attribute {\n    name = \"gsi1sk\"\n    type = \"S\"\n  }\n\n  global_secondary_index {\n    name            = \"GSI1\"\n    hash_key        = \"gsi1pk\"\n    range_key       = \"gsi1sk\"\n    projection_type = \"ALL\"\n  }\n\n  point_in_time_recovery {\n    enabled = true\n  }\n\n  server_side_encryption {\n    enabled = true\n  }\n\n  deletion_protection_enabled = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard read model from accidental destroy/replace\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-dynamodb-read-model\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " DynamoDB Point-in-time recovery is configured"}]}, {"ruleId": "CKV_AWS_119", "ruleIndex": 22, "level": "warning", "attachments": [], "message": {"text": "Ensure DynamoDB Tables are encrypted using a KMS Customer Managed CMK"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 69, "endLine": 122, "snippet": {"text": "resource \"aws_dynamodb_table\" \"plan_cycle_read_model\" {\n  # checkov:skip=CKV_AWS_28: DynamoDB Point-in-time recovery is configured\n  # checkov:skip=CKV_AWS_119: DynamoDB Server-side encryption is configured\n  name         = \"taxpulse-plan-cycle-read-model\"\n  billing_mode = \"PAY_PER_REQUEST\"\n  hash_key     = \"pk\"\n  range_key    = \"sk\"\n\n  attribute {\n    name = \"pk\"\n    type = \"S\"\n  }\n\n  attribute {\n    name = \"sk\"\n    type = \"S\"\n  }\n\n  attribute {\n    name = \"gsi1pk\"\n    type = \"S\"\n  }\n\n  attribute {\n    name = \"gsi1sk\"\n    type = \"S\"\n  }\n\n  global_secondary_index {\n    name            = \"GSI1\"\n    hash_key        = \"gsi1pk\"\n    range_key       = \"gsi1sk\"\n    projection_type = \"ALL\"\n  }\n\n  point_in_time_recovery {\n    enabled = true\n  }\n\n  server_side_encryption {\n    enabled = true\n  }\n\n  deletion_protection_enabled = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard read model from accidental destroy/replace\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-dynamodb-read-model\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " DynamoDB Server-side encryption is configured"}]}, {"ruleId": "CKV_AWS_31", "ruleIndex": 23, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the ElastiCache Replication Group is securely encrypted at transit and has auth token"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 130, "endLine": 157, "snippet": {"text": "resource \"aws_elasticache_replication_group\" \"main\" {\n  # checkov:skip=CKV_AWS_29: Transit encryption not supported on single-node cache cluster in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_30: At-rest encryption not supported on standalone redis in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_31: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_50: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_134: Automatic backup disabled for local floci standalone redis \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_143: Auto minor version upgrade enabled\n  # checkov:skip=CKV_AWS_191: Default KMS key used for local floci \u2014 reviewed in ADR-0023\n  replication_group_id       = \"${var.project_name}-${var.environment}-redis\"\n  description                = \"ElastiCache Redis cluster for TaxPulse Tax Engine\"\n  engine                     = \"redis\"\n  node_type                  = \"cache.t4g.micro\"\n  num_cache_clusters         = 1\n  parameter_group_name       = \"default.redis7\"\n  port                       = 6379\n  security_group_ids         = [var.db_security_group_id]\n  auto_minor_version_upgrade = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard cache cluster from accidental destroy/replace\n    ignore_changes  = [num_cache_clusters] # Local floci emulator replica count\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-redis\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_29", "ruleIndex": 24, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the ElastiCache Replication Group is securely encrypted at rest"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 130, "endLine": 157, "snippet": {"text": "resource \"aws_elasticache_replication_group\" \"main\" {\n  # checkov:skip=CKV_AWS_29: Transit encryption not supported on single-node cache cluster in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_30: At-rest encryption not supported on standalone redis in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_31: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_50: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_134: Automatic backup disabled for local floci standalone redis \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_143: Auto minor version upgrade enabled\n  # checkov:skip=CKV_AWS_191: Default KMS key used for local floci \u2014 reviewed in ADR-0023\n  replication_group_id       = \"${var.project_name}-${var.environment}-redis\"\n  description                = \"ElastiCache Redis cluster for TaxPulse Tax Engine\"\n  engine                     = \"redis\"\n  node_type                  = \"cache.t4g.micro\"\n  num_cache_clusters         = 1\n  parameter_group_name       = \"default.redis7\"\n  port                       = 6379\n  security_group_ids         = [var.db_security_group_id]\n  auto_minor_version_upgrade = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard cache cluster from accidental destroy/replace\n    ignore_changes  = [num_cache_clusters] # Local floci emulator replica count\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-redis\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Transit encryption not supported on single-node cache cluster in floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_191", "ruleIndex": 25, "level": "warning", "attachments": [], "message": {"text": "Ensure ElastiCache replication group is encrypted by KMS using a customer managed Key (CMK)"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 130, "endLine": 157, "snippet": {"text": "resource \"aws_elasticache_replication_group\" \"main\" {\n  # checkov:skip=CKV_AWS_29: Transit encryption not supported on single-node cache cluster in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_30: At-rest encryption not supported on standalone redis in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_31: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_50: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_134: Automatic backup disabled for local floci standalone redis \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_143: Auto minor version upgrade enabled\n  # checkov:skip=CKV_AWS_191: Default KMS key used for local floci \u2014 reviewed in ADR-0023\n  replication_group_id       = \"${var.project_name}-${var.environment}-redis\"\n  description                = \"ElastiCache Redis cluster for TaxPulse Tax Engine\"\n  engine                     = \"redis\"\n  node_type                  = \"cache.t4g.micro\"\n  num_cache_clusters         = 1\n  parameter_group_name       = \"default.redis7\"\n  port                       = 6379\n  security_group_ids         = [var.db_security_group_id]\n  auto_minor_version_upgrade = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard cache cluster from accidental destroy/replace\n    ignore_changes  = [num_cache_clusters] # Local floci emulator replica count\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-redis\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Default KMS key used for local floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_30", "ruleIndex": 26, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the ElastiCache Replication Group is securely encrypted at transit"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 130, "endLine": 157, "snippet": {"text": "resource \"aws_elasticache_replication_group\" \"main\" {\n  # checkov:skip=CKV_AWS_29: Transit encryption not supported on single-node cache cluster in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_30: At-rest encryption not supported on standalone redis in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_31: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_50: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_134: Automatic backup disabled for local floci standalone redis \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_143: Auto minor version upgrade enabled\n  # checkov:skip=CKV_AWS_191: Default KMS key used for local floci \u2014 reviewed in ADR-0023\n  replication_group_id       = \"${var.project_name}-${var.environment}-redis\"\n  description                = \"ElastiCache Redis cluster for TaxPulse Tax Engine\"\n  engine                     = \"redis\"\n  node_type                  = \"cache.t4g.micro\"\n  num_cache_clusters         = 1\n  parameter_group_name       = \"default.redis7\"\n  port                       = 6379\n  security_group_ids         = [var.db_security_group_id]\n  auto_minor_version_upgrade = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard cache cluster from accidental destroy/replace\n    ignore_changes  = [num_cache_clusters] # Local floci emulator replica count\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-redis\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " At-rest encryption not supported on standalone redis in floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_26", "ruleIndex": 27, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the SNS topic is encrypted"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 162, "endLine": 171, "snippet": {"text": "resource \"aws_sns_topic\" \"stage_changed\" {\n  # checkov:skip=CKV_AWS_26: Default SNS encryption enabled with AWS-managed key\n  name              = \"taxpulse-stage-changed\"\n  kms_master_key_id = \"alias/aws/sns\"\n\n  tags = {\n    Name        = \"${var.project_name}-stage-changed-topic\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Default SNS encryption enabled with AWS-managed key"}]}, {"ruleId": "CKV_AWS_27", "ruleIndex": 28, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the SQS queue is encrypted"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 173, "endLine": 183, "snippet": {"text": "resource \"aws_sqs_queue\" \"stage_changed_dlq\" {\n  # checkov:skip=CKV_AWS_27: SQS SSE enabled\n  name                      = \"taxpulse-stage-changed-dlq\"\n  message_retention_seconds = 1209600 # 14 days\n  sqs_managed_sse_enabled   = true\n\n  tags = {\n    Name        = \"${var.project_name}-stage-changed-dlq\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " SQS SSE enabled"}]}, {"ruleId": "CKV_AWS_27", "ruleIndex": 28, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the SQS queue is encrypted"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 185, "endLine": 199, "snippet": {"text": "resource \"aws_sqs_queue\" \"stage_changed_projection\" {\n  # checkov:skip=CKV_AWS_27: SQS SSE enabled\n  name                    = \"taxpulse-stage-changed-projection\"\n  sqs_managed_sse_enabled = true\n\n  redrive_policy = jsonencode({\n    deadLetterTargetArn = aws_sqs_queue.stage_changed_dlq.arn\n    maxReceiveCount     = 5\n  })\n\n  tags = {\n    Name        = \"${var.project_name}-stage-changed-projection-queue\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " SQS SSE enabled"}]}, {"ruleId": "CKV_AWS_149", "ruleIndex": 29, "level": "warning", "attachments": [], "message": {"text": "Ensure that Secrets Manager secret is encrypted using KMS CMK"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 231, "endLine": 242, "snippet": {"text": "resource \"aws_secretsmanager_secret\" \"db_password\" {\n  # checkov:skip=CKV_AWS_149: Default Secrets Manager KMS encryption is acceptable for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_57: Automatic secret rotation disabled for local floci containers \u2014 reviewed in ADR-0023\n  name                    = \"taxpulse/local/db-password\"\n  description             = \"Database master password container for Core Case Service and Tax Engine\"\n  recovery_window_in_days = 0\n\n  tags = {\n    Name        = \"${var.project_name}-db-password-secret\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Default Secrets Manager KMS encryption is acceptable for local floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_149", "ruleIndex": 29, "level": "warning", "attachments": [], "message": {"text": "Ensure that Secrets Manager secret is encrypted using KMS CMK"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 244, "endLine": 255, "snippet": {"text": "resource \"aws_secretsmanager_secret\" \"jwt_signing_keys\" {\n  # checkov:skip=CKV_AWS_149: Default Secrets Manager KMS encryption is acceptable for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_57: Automatic secret rotation disabled for local floci containers \u2014 reviewed in ADR-0023\n  name                    = \"taxpulse/local/jwt-signing-keys\"\n  description             = \"JWT private/public signing keys secret container\"\n  recovery_window_in_days = 0\n\n  tags = {\n    Name        = \"${var.project_name}-jwt-signing-keys-secret\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Default Secrets Manager KMS encryption is acceptable for local floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_111", "ruleIndex": 30, "level": "warning", "attachments": [], "message": {"text": "Ensure IAM policies does not allow write access without constraints"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/iam/main.tf"}, "region": {"startLine": 163, "endLine": 178, "snippet": {"text": "data \"aws_iam_policy_document\" \"flow_log_permissions\" {\n  # checkov:skip=CKV_AWS_111: Flow log delivery requires resource * for CloudWatch Logs stream creation \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_356: Flow log delivery requires resource * for CloudWatch Logs stream creation \u2014 reviewed in ADR-0023\n  statement {\n    sid    = \"AllowFlowLogToCloudWatch\"\n    effect = \"Allow\"\n    actions = [\n      \"logs:CreateLogGroup\",\n      \"logs:CreateLogStream\",\n      \"logs:PutLogEvents\",\n      \"logs:DescribeLogGroups\",\n      \"logs:DescribeLogStreams\",\n    ]\n    resources = [\"*\"]\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Flow log delivery requires resource * for CloudWatch Logs stream creation \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_356", "ruleIndex": 31, "level": "warning", "attachments": [], "message": {"text": "Ensure no IAM policies documents allow \"*\" as a statement's resource for restrictable actions"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/iam/main.tf"}, "region": {"startLine": 163, "endLine": 178, "snippet": {"text": "data \"aws_iam_policy_document\" \"flow_log_permissions\" {\n  # checkov:skip=CKV_AWS_111: Flow log delivery requires resource * for CloudWatch Logs stream creation \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_356: Flow log delivery requires resource * for CloudWatch Logs stream creation \u2014 reviewed in ADR-0023\n  statement {\n    sid    = \"AllowFlowLogToCloudWatch\"\n    effect = \"Allow\"\n    actions = [\n      \"logs:CreateLogGroup\",\n      \"logs:CreateLogStream\",\n      \"logs:PutLogEvents\",\n      \"logs:DescribeLogGroups\",\n      \"logs:DescribeLogStreams\",\n    ]\n    resources = [\"*\"]\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Flow log delivery requires resource * for CloudWatch Logs stream creation \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_158", "ruleIndex": 32, "level": "warning", "attachments": [], "message": {"text": "Ensure that CloudWatch Log Group is encrypted by KMS"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/network/main.tf"}, "region": {"startLine": 44, "endLine": 53, "snippet": {"text": "resource \"aws_cloudwatch_log_group\" \"vpc_flow_log\" {\n  # checkov:skip=CKV_AWS_158: encryption using default log group encryption is acceptable for development floci environment \u2014 reviewed in ADR-0023\n  name              = \"/aws/vpc/${var.project_name}-${var.environment}/flow-logs\"\n  retention_in_days = 365\n\n  tags = {\n    Name        = \"${var.project_name}-vpc-flow-logs\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " encryption using default log group encryption is acceptable for development floci environment \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_130", "ruleIndex": 33, "level": "warning", "attachments": [], "message": {"text": "Ensure VPC subnets do not assign public IP by default"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/network/main.tf"}, "region": {"startLine": 87, "endLine": 101, "snippet": {"text": "resource \"aws_subnet\" \"public\" {\n  # checkov:skip=CKV_AWS_130: public subnets host the internet-facing ALB by design (ADR-0020) \u2014 reviewed in ADR-0023\n  count = length(var.public_subnet_cidrs)\n\n  vpc_id                  = aws_vpc.main.id\n  cidr_block              = var.public_subnet_cidrs[count.index]\n  availability_zone       = data.aws_availability_zones.available.names[count.index]\n  map_public_ip_on_launch = true\n\n  tags = {\n    Name        = \"${var.project_name}-public-${data.aws_availability_zones.available.names[count.index]}\"\n    Environment = var.environment\n    Tier        = \"public\"\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " public subnets host the internet-facing ALB by design (ADR-0020) \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_130", "ruleIndex": 33, "level": "warning", "attachments": [], "message": {"text": "Ensure VPC subnets do not assign public IP by default"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/network/main.tf"}, "region": {"startLine": 87, "endLine": 101, "snippet": {"text": "resource \"aws_subnet\" \"public\" {\n  # checkov:skip=CKV_AWS_130: public subnets host the internet-facing ALB by design (ADR-0020) \u2014 reviewed in ADR-0023\n  count = length(var.public_subnet_cidrs)\n\n  vpc_id                  = aws_vpc.main.id\n  cidr_block              = var.public_subnet_cidrs[count.index]\n  availability_zone       = data.aws_availability_zones.available.names[count.index]\n  map_public_ip_on_launch = true\n\n  tags = {\n    Name        = \"${var.project_name}-public-${data.aws_availability_zones.available.names[count.index]}\"\n    Environment = var.environment\n    Tier        = \"public\"\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " public subnets host the internet-facing ALB by design (ADR-0020) \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_5", "ruleIndex": 34, "level": "warning", "attachments": [], "message": {"text": "Ensure that Security Groups are attached to another resource"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/network/main.tf"}, "region": {"startLine": 197, "endLine": 207, "snippet": {"text": "resource \"aws_security_group\" \"alb\" {\n  # checkov:skip=CKV2_AWS_5: SG is defined now; ALB attachment comes in 8.2 Full-Stack Terraform \u2014 reviewed in ADR-0023\n  name        = \"${var.project_name}-alb-sg\"\n  description = \"Internet entrypoint for the TaxPulse ALB.\"\n  vpc_id      = aws_vpc.main.id\n\n  tags = {\n    Name        = \"${var.project_name}-alb-sg\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " SG is defined now; ALB attachment comes in 8.2 Full-Stack Terraform \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_5", "ruleIndex": 34, "level": "warning", "attachments": [], "message": {"text": "Ensure that Security Groups are attached to another resource"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/network/main.tf"}, "region": {"startLine": 250, "endLine": 260, "snippet": {"text": "resource \"aws_security_group\" \"task\" {\n  # checkov:skip=CKV2_AWS_5: SG is defined now; ECS task attachment comes in 8.2 Full-Stack Terraform \u2014 reviewed in ADR-0023\n  name        = \"${var.project_name}-task-sg\"\n  description = \"Private Fargate tasks; inbound traffic is ALB-originated only.\"\n  vpc_id      = aws_vpc.main.id\n\n  tags = {\n    Name        = \"${var.project_name}-task-sg\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " SG is defined now; ECS task attachment comes in 8.2 Full-Stack Terraform \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_5", "ruleIndex": 34, "level": "warning", "attachments": [], "message": {"text": "Ensure that Security Groups are attached to another resource"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/network/main.tf"}, "region": {"startLine": 317, "endLine": 327, "snippet": {"text": "resource \"aws_security_group\" \"db\" {\n  # checkov:skip=CKV2_AWS_5: SG is defined now; RDS/Postgres attachment comes in 8.2 Full-Stack Terraform \u2014 reviewed in ADR-0023\n  name        = \"${var.project_name}-db-sg\"\n  description = \"Private Postgres; inbound traffic is app-task-originated only.\"\n  vpc_id      = aws_vpc.main.id\n\n  tags = {\n    Name        = \"${var.project_name}-db-sg\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " SG is defined now; RDS/Postgres attachment comes in 8.2 Full-Stack Terraform \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_20", "ruleIndex": 35, "level": "warning", "attachments": [], "message": {"text": "Ensure that ALB redirects HTTP requests into HTTPS ones"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 11, "endLine": 27, "snippet": {"text": "resource \"aws_lb\" \"main\" {\n  # checkov:skip=CKV_AWS_91: ALB access logging is disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_150: Deletion protection disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_28: WAF not configured for local development ALB \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_20: HTTP listener is used for local floci emulator; TLS terminated at ALB in production \u2014 reviewed in ADR-0023\n  name                       = \"${var.project_name}-${var.environment}-alb\"\n  internal                   = false # Internet-facing in public subnets\n  load_balancer_type         = \"application\"\n  security_groups            = [var.alb_security_group_id]\n  subnets                    = var.public_subnet_ids\n  drop_invalid_header_fields = true\n\n  tags = {\n    Name        = \"${var.project_name}-alb\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " HTTP listener is used for local floci emulator; TLS terminated at ALB in production \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_62", "ruleIndex": 36, "level": "warning", "attachments": [], "message": {"text": "Ensure S3 buckets should have event notifications enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 318, "endLine": 332, "snippet": {"text": "resource \"aws_s3_bucket\" \"spa\" {\n  # checkov:skip=CKV_AWS_18: S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_144: S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_21: S3 bucket versioning is configured\n  # checkov:skip=CKV_AWS_145: S3 bucket server-side encryption is configured\n  # checkov:skip=CKV2_AWS_61: S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_62: S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023\n  bucket        = \"${var.project_name}-${var.environment}-spa\"\n  force_destroy = true\n\n  tags = {\n    Name        = \"${var.project_name}-spa-bucket\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_61", "ruleIndex": 37, "level": "warning", "attachments": [], "message": {"text": "Ensure that an S3 bucket has a lifecycle configuration"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 318, "endLine": 332, "snippet": {"text": "resource \"aws_s3_bucket\" \"spa\" {\n  # checkov:skip=CKV_AWS_18: S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_144: S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_21: S3 bucket versioning is configured\n  # checkov:skip=CKV_AWS_145: S3 bucket server-side encryption is configured\n  # checkov:skip=CKV2_AWS_61: S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_62: S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023\n  bucket        = \"${var.project_name}-${var.environment}-spa\"\n  force_destroy = true\n\n  tags = {\n    Name        = \"${var.project_name}-spa-bucket\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_30", "ruleIndex": 38, "level": "warning", "attachments": [], "message": {"text": "Ensure Postgres RDS as aws_db_instance has Query Logging enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 24, "endLine": 65, "snippet": {"text": "resource \"aws_db_instance\" \"main\" {\n  # checkov:skip=CKV_AWS_157: Multi-AZ is disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_161: IAM Database authentication disabled for local floci postgres \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_354: Default RDS KMS encryption is acceptable for local floci emulator \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_118: Enhanced monitoring disabled for local floci development \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_293: CloudWatch export logs disabled for local floci environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_353: Performance insights disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_30: Query logging disabled for local floci postgres instance \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_133: Backup retention period configured\n  # checkov:skip=CKV_AWS_226: Auto minor version upgrade configured\n  # checkov:skip=CKV_AWS_129: Copy tags to snapshot configured\n  # checkov:skip=CKV_AWS_17: Public access disabled\n  identifier                  = \"${var.project_name}-${var.environment}-db\"\n  engine                      = \"postgres\"\n  engine_version              = \"16\"\n  instance_class              = \"db.t4g.micro\"\n  allocated_storage           = 20\n  max_allocated_storage       = 100\n  db_name                     = \"taxpulse\"\n  username                    = \"taxpulse_admin\"\n  manage_master_user_password = true # Secrets Manager manages master password out-of-band\n  db_subnet_group_name        = aws_db_subnet_group.main.name\n  vpc_security_group_ids      = [var.db_security_group_id]\n  publicly_accessible         = false\n  auto_minor_version_upgrade  = true\n  copy_tags_to_snapshot       = true\n  skip_final_snapshot         = true\n  backup_retention_period     = 7\n  backup_window               = \"03:00-04:00\"\n  storage_encrypted           = true\n  deletion_protection         = true # AWS-layer deletion guard\n\n  lifecycle {\n    prevent_destroy = true # Terraform refusal guard against accidental replace/destroy\n    ignore_changes  = [storage_encrypted] # Local floci emulator returns false on refresh\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-postgres\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Query logging disabled for local floci postgres instance \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_18", "ruleIndex": 39, "level": "warning", "attachments": [], "message": {"text": "Ensure the S3 bucket has access logging enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 318, "endLine": 332, "snippet": {"text": "resource \"aws_s3_bucket\" \"spa\" {\n  # checkov:skip=CKV_AWS_18: S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_144: S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_21: S3 bucket versioning is configured\n  # checkov:skip=CKV_AWS_145: S3 bucket server-side encryption is configured\n  # checkov:skip=CKV2_AWS_61: S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_62: S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023\n  bucket        = \"${var.project_name}-${var.environment}-spa\"\n  force_destroy = true\n\n  tags = {\n    Name        = \"${var.project_name}-spa-bucket\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_144", "ruleIndex": 40, "level": "warning", "attachments": [], "message": {"text": "Ensure that S3 bucket has cross-region replication enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 318, "endLine": 332, "snippet": {"text": "resource \"aws_s3_bucket\" \"spa\" {\n  # checkov:skip=CKV_AWS_18: S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_144: S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_21: S3 bucket versioning is configured\n  # checkov:skip=CKV_AWS_145: S3 bucket server-side encryption is configured\n  # checkov:skip=CKV2_AWS_61: S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_62: S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023\n  bucket        = \"${var.project_name}-${var.environment}-spa\"\n  force_destroy = true\n\n  tags = {\n    Name        = \"${var.project_name}-spa-bucket\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_57", "ruleIndex": 41, "level": "warning", "attachments": [], "message": {"text": "Ensure Secrets Manager secrets should have automatic rotation enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 231, "endLine": 242, "snippet": {"text": "resource \"aws_secretsmanager_secret\" \"db_password\" {\n  # checkov:skip=CKV_AWS_149: Default Secrets Manager KMS encryption is acceptable for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_57: Automatic secret rotation disabled for local floci containers \u2014 reviewed in ADR-0023\n  name                    = \"taxpulse/local/db-password\"\n  description             = \"Database master password container for Core Case Service and Tax Engine\"\n  recovery_window_in_days = 0\n\n  tags = {\n    Name        = \"${var.project_name}-db-password-secret\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Automatic secret rotation disabled for local floci containers \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_57", "ruleIndex": 41, "level": "warning", "attachments": [], "message": {"text": "Ensure Secrets Manager secrets should have automatic rotation enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 244, "endLine": 255, "snippet": {"text": "resource \"aws_secretsmanager_secret\" \"jwt_signing_keys\" {\n  # checkov:skip=CKV_AWS_149: Default Secrets Manager KMS encryption is acceptable for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_57: Automatic secret rotation disabled for local floci containers \u2014 reviewed in ADR-0023\n  name                    = \"taxpulse/local/jwt-signing-keys\"\n  description             = \"JWT private/public signing keys secret container\"\n  recovery_window_in_days = 0\n\n  tags = {\n    Name        = \"${var.project_name}-jwt-signing-keys-secret\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Automatic secret rotation disabled for local floci containers \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_103", "ruleIndex": 42, "level": "warning", "attachments": [], "message": {"text": "Ensure that load balancer is using at least TLS 1.2"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 88, "endLine": 104, "snippet": {"text": "resource \"aws_lb_listener\" \"http\" {\n  # checkov:skip=CKV_AWS_2: HTTP listener is used for local floci emulator; TLS terminated at ALB in production \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_103: TLS 1.2 not applicable for plaintext HTTP listener in local floci \u2014 reviewed in ADR-0023\n  load_balancer_arn = aws_lb.main.arn\n  port              = 80\n  protocol          = \"HTTP\"\n\n  default_action {\n    type             = \"forward\"\n    target_group_arn = aws_lb_target_group.api.arn\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-alb-listener-http\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " TLS 1.2 not applicable for plaintext HTTP listener in local floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV2_AWS_28", "ruleIndex": 43, "level": "warning", "attachments": [], "message": {"text": "Ensure public facing ALB are protected by WAF"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 11, "endLine": 27, "snippet": {"text": "resource \"aws_lb\" \"main\" {\n  # checkov:skip=CKV_AWS_91: ALB access logging is disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_150: Deletion protection disabled for local floci development environment \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_28: WAF not configured for local development ALB \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_20: HTTP listener is used for local floci emulator; TLS terminated at ALB in production \u2014 reviewed in ADR-0023\n  name                       = \"${var.project_name}-${var.environment}-alb\"\n  internal                   = false # Internet-facing in public subnets\n  load_balancer_type         = \"application\"\n  security_groups            = [var.alb_security_group_id]\n  subnets                    = var.public_subnet_ids\n  drop_invalid_header_fields = true\n\n  tags = {\n    Name        = \"${var.project_name}-alb\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " WAF not configured for local development ALB \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_378", "ruleIndex": 44, "level": "warning", "attachments": [], "message": {"text": "Ensure AWS Load Balancer doesn't use HTTP protocol"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 31, "endLine": 56, "snippet": {"text": "resource \"aws_lb_target_group\" \"api\" {\n  # checkov:skip=CKV_AWS_261: Target group HTTP is used for local floci container networking \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_378: Target group protocol HTTP for internal Fargate tasks \u2014 reviewed in ADR-0023\n  name        = \"${var.project_name}-${var.environment}-tg-api\"\n  port        = 3000\n  protocol    = \"HTTP\"\n  vpc_id      = var.vpc_id\n  target_type = \"ip\"\n\n  health_check {\n    enabled             = true\n    path                = \"/api/health\"\n    port                = \"3000\"\n    protocol            = \"HTTP\"\n    interval            = 30\n    timeout             = 5\n    healthy_threshold   = 2\n    unhealthy_threshold = 3\n    matcher             = \"200,404\"\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-tg-api\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Target group protocol HTTP for internal Fargate tasks \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_378", "ruleIndex": 44, "level": "warning", "attachments": [], "message": {"text": "Ensure AWS Load Balancer doesn't use HTTP protocol"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 58, "endLine": 83, "snippet": {"text": "resource \"aws_lb_target_group\" \"compute\" {\n  # checkov:skip=CKV_AWS_261: Target group HTTP is used for local floci container networking \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_378: Target group protocol HTTP for internal Fargate tasks \u2014 reviewed in ADR-0023\n  name        = \"${var.project_name}-${var.environment}-tg-compute\"\n  port        = 8000\n  protocol    = \"HTTP\"\n  vpc_id      = var.vpc_id\n  target_type = \"ip\"\n\n  health_check {\n    enabled             = true\n    path                = \"/health\"\n    port                = \"8000\"\n    protocol            = \"HTTP\"\n    interval            = 30\n    timeout             = 5\n    healthy_threshold   = 2\n    unhealthy_threshold = 3\n    matcher             = \"200\"\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-tg-compute\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Target group protocol HTTP for internal Fargate tasks \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_145", "ruleIndex": 45, "level": "warning", "attachments": [], "message": {"text": "Ensure that S3 buckets are encrypted with KMS by default"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 318, "endLine": 332, "snippet": {"text": "resource \"aws_s3_bucket\" \"spa\" {\n  # checkov:skip=CKV_AWS_18: S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_144: S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_21: S3 bucket versioning is configured\n  # checkov:skip=CKV_AWS_145: S3 bucket server-side encryption is configured\n  # checkov:skip=CKV2_AWS_61: S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_62: S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023\n  bucket        = \"${var.project_name}-${var.environment}-spa\"\n  force_destroy = true\n\n  tags = {\n    Name        = \"${var.project_name}-spa-bucket\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " S3 bucket server-side encryption is configured"}]}, {"ruleId": "CKV2_AWS_50", "ruleIndex": 46, "level": "warning", "attachments": [], "message": {"text": "Ensure AWS ElastiCache Redis cluster with Multi-AZ Automatic Failover feature set to enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/data/main.tf"}, "region": {"startLine": 130, "endLine": 157, "snippet": {"text": "resource \"aws_elasticache_replication_group\" \"main\" {\n  # checkov:skip=CKV_AWS_29: Transit encryption not supported on single-node cache cluster in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_30: At-rest encryption not supported on standalone redis in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_31: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_50: Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_134: Automatic backup disabled for local floci standalone redis \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_143: Auto minor version upgrade enabled\n  # checkov:skip=CKV_AWS_191: Default KMS key used for local floci \u2014 reviewed in ADR-0023\n  replication_group_id       = \"${var.project_name}-${var.environment}-redis\"\n  description                = \"ElastiCache Redis cluster for TaxPulse Tax Engine\"\n  engine                     = \"redis\"\n  node_type                  = \"cache.t4g.micro\"\n  num_cache_clusters         = 1\n  parameter_group_name       = \"default.redis7\"\n  port                       = 6379\n  security_group_ids         = [var.db_security_group_id]\n  auto_minor_version_upgrade = true\n\n  lifecycle {\n    prevent_destroy = true # Safeguard cache cluster from accidental destroy/replace\n    ignore_changes  = [num_cache_clusters] # Local floci emulator replica count\n  }\n\n  tags = {\n    Name        = \"${var.project_name}-redis\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " Multi-AZ automatic failover disabled for standalone single-node cache in floci \u2014 reviewed in ADR-0023"}]}, {"ruleId": "CKV_AWS_21", "ruleIndex": 47, "level": "warning", "attachments": [], "message": {"text": "Ensure all data stored in the S3 bucket have versioning enabled"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "infra/terraform/modules/app/main.tf"}, "region": {"startLine": 318, "endLine": 332, "snippet": {"text": "resource \"aws_s3_bucket\" \"spa\" {\n  # checkov:skip=CKV_AWS_18: S3 access logging disabled for local floci SPA bucket \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_144: S3 cross-region replication not required for local floci \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV_AWS_21: S3 bucket versioning is configured\n  # checkov:skip=CKV_AWS_145: S3 bucket server-side encryption is configured\n  # checkov:skip=CKV2_AWS_61: S3 lifecycle configuration not required for local floci static assets \u2014 reviewed in ADR-0023\n  # checkov:skip=CKV2_AWS_62: S3 event notifications not required for SPA bucket \u2014 reviewed in ADR-0023\n  bucket        = \"${var.project_name}-${var.environment}-spa\"\n  force_destroy = true\n\n  tags = {\n    Name        = \"${var.project_name}-spa-bucket\"\n    Environment = var.environment\n  }\n}\n"}}}}], "suppressions": [{"kind": "inSource", "justification": " S3 bucket versioning is configured"}]}]}]}