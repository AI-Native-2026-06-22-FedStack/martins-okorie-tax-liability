  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "AWS-0017",
              "name": "Misconfiguration",
              "shortDescription": {
                "text": "CloudWatch log groups should be encrypted using CMK"
              },
              "fullDescription": {
                "text": "CloudWatch log groups are encrypted by default, however, to get the full benefit of controlling key rotation and other KMS aspects a KMS CMK should be used.\n"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://avd.aquasec.com/misconfig/aws-0017",
              "help": {
                "text": "Misconfiguration AWS-0017\nType: Terraform Security Check\nSeverity: LOW\nCheck: CloudWatch log groups should be encrypted using CMK\nMessage: Log group is not encrypted.\nLink: [AWS-0017](https://avd.aquasec.com/misconfig/aws-0017)\nCloudWatch log groups are encrypted by default, however, to get the full benefit of controlling key rotation and other KMS aspects a KMS CMK should be used.\n",
                "markdown": "**Misconfiguration AWS-0017**\n| Type | Severity | Check | Message | Link |\n| --- | --- | --- | --- | --- |\n|Terraform Security Check|LOW|CloudWatch log groups should be encrypted using CMK|Log group is not encrypted.|[AWS-0017](https://avd.aquasec.com/misconfig/aws-0017)|\n\nCloudWatch log groups are encrypted by default, however, to get the full benefit of controlling key rotation and other KMS aspects a KMS CMK should be used.\n"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "2.0",
                "tags": [
                  "misconfiguration",
                  "security",
                  "LOW"
                ]
              }
            }
          ],
          "version": "0.73.0"
        }
      },
      "results": [
        {
          "ruleId": "AWS-0017",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "Artifact: modules/network/main.tf\nType: terraform\nVulnerability AWS-0017\nSeverity: LOW\nMessage: Log group is not encrypted.\nLink: [AWS-0017](https://avd.aquasec.com/misconfig/aws-0017)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "modules/network/main.tf",
                  "uriBaseId": "ROOTPATH"
                },
                "region": {
