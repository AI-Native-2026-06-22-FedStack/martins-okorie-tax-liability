# TaxPulse root workspace environment
# Copy non-secret defaults to `.env`; put private overrides, such as OPENAI_API_KEY, in `.env.local`.

# Local Postgres / Drizzle tooling
DATABASE_URI=postgresql://taxpulse_app@localhost:55433/taxpulse_l
TAXPULSE_TEST_DATABASE_URL=postgresql://taxpulse_app@localhost:55433/taxpulse_l

# Pipeline / RAG local runtime
DATABASE_URL=postgresql://taxpulse_app@localhost:55433/taxpulse_l
OPENAI_API_KEY=
QUARANTINE_BUCKET=taxpulse-analytics-quarantine
QUARANTINE_RATE_THRESHOLD=0.02
STAGE_CHANGED_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:taxpulse-stage-changed

# Local AWS emulator shared by pipeline and API tests
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Local service endpoints
REDIS_URL=redis://localhost:6379
API_BASE_URL=http://localhost:3000
COMPUTE_SERVICE_URL=http://localhost:8001
TIVS_ACL_BASE_URL=http://localhost:4300
