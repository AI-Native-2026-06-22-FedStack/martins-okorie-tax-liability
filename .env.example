# Commit the EXAMPLE only; never commit the real .env. No database connection
# string, DB password, JWT signing key, or private key belongs in this file.
# Runtime secrets load from Secrets Manager by SecretId reference.
AWS_ENDPOINT=http://localhost.floci.io:4566
# Floci local AWS emulator; real AWS endpoint/configuration in deployment.
AWS_REGION=us-east-1
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taxpulse
DB_USER=taxpulse_app
DB_SSL=disable
DB_SECRET_ID=taxpulse/db-password
JWT_SECRET_ID=taxpulse/jwt-signing-keys
SECRETS_REFRESH_MS=300000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
JWT_ISSUER=taxpulse-api
JWT_AUDIENCE=taxpulse-clients

# The Redis the rate-limit shared store connects to:
REDIS_URL=redis://localhost:6379
# Per-tenant rate limit, tunable per environment without a code change:
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
