{
  "// path": "alb/listener.json",
  "// note": "Skeleton only. Routes /v1 to the Core Case Service target group; concrete ARNs are filled in Task 3.",
  "loadBalancerArn": "<taxpulse ALB arn>",
  "port": 80,
  "protocol": "HTTP",
  "defaultActions": [
    {
      "type": "fixed-response",
      "fixedResponseConfig": {
        "statusCode": "404",
        "contentType": "application/json",
        "messageBody": "{\"error\":\"not_found\"}"
      }
    }
  ],
  "rules": [
    {
      "priority": 10,
      "conditions": [
        {
          "field": "path-pattern",
          "values": [
            "/v1/*"
          ]
        }
      ],
      "actions": [
        {
          "type": "forward",
          "targetGroupArn": "<taxpulse-api target group arn>"
        }
      ]
    }
  ]
}
