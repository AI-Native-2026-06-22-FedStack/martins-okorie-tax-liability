DATABASE_URI=postgres://localhost:5432/taxpulse
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
JWT_ISSUER=taxpulse-api
JWT_AUDIENCE=taxpulse-clients
