{
  "// path": "ecs/task-definition.json",
  "// note": "One task definition per long-lived service. Register each object under taskDefinitions with aws ecs register-task-definition.",
  "taskDefinitions": [
    {
      "family": "taxpulse-api",
      "requiresCompatibilities": [
        "FARGATE"
      ],
      "networkMode": "awsvpc",
      "cpu": "256",
      "memory": "512",
      "executionRoleArn": "arn:aws:iam::000000000000:role/taxpulse-ecs-execution",
      "taskRoleArn": "arn:aws:iam::000000000000:role/taxpulse-ecs-task",
      "containerDefinitions": [
        {
          "name": "api",
          "image": "000000000000.dkr.ecr.us-east-1.localhost:5100/000000000000/us-east-1/taxpulse-api:w7d1",
          "essential": true,
          "portMappings": [
            {
              "containerPort": 3000,
              "hostPort": 3000,
              "protocol": "tcp",
              "name": "http"
            }
          ],
          "environment": [
            {
              "name": "AWS_ACCESS_KEY_ID",
              "value": "test"
            },
            {
              "name": "AWS_ENDPOINT",
              "value": "http://floci:4566"
            },
            {
              "name": "AWS_ENDPOINT_URL",
              "value": "http://floci:4566"
            },
            {
              "name": "AWS_REGION",
              "value": "us-east-1"
            },
            {
              "name": "AWS_SECRET_ACCESS_KEY",
              "value": "test"
            },
            {
              "name": "COMPUTE_SERVICE_URL",
              "value": "http://taxpulse-compute.local:8000"
            },
            {
              "name": "DB_HOST",
              "value": "postgres"
            },
            {
              "name": "DB_NAME",
              "value": "taxpulse_l"
            },
            {
              "name": "DB_PORT",
              "value": "5432"
            },
            {
              "name": "DB_SECRET_ID",
              "value": "taxpulse/local/db-password"
            },
            {
              "name": "DB_SSL",
              "value": "disable"
            },
            {
              "name": "DB_USER",
              "value": "taxpulse_app"
            },
            {
              "name": "DDB_ENDPOINT",
              "value": "http://floci:4566"
            },
            {
              "name": "JWT_AUDIENCE",
              "value": "taxpulse-clients"
            },
            {
              "name": "JWT_ISSUER",
              "value": "taxpulse-api"
            },
            {
              "name": "JWT_SECRET_ID",
              "value": "taxpulse/local/jwt-signing-keys"
            },
            {
              "name": "PORT",
              "value": "3000"
            },
            {
              "name": "REDIS_URL",
              "value": "redis://redis:6379"
            }
          ],
          "secrets": [
            {
              "name": "DATABASE_PASSWORD",
              "valueFrom": "arn:aws:secretsmanager:us-east-1:000000000000:secret:taxpulse/local/db-password"
            },
            {
              "name": "JWT_SIGNING_KEYS",
              "valueFrom": "arn:aws:secretsmanager:us-east-1:000000000000:secret:taxpulse/local/jwt-signing-keys"
            }
          ],
          "healthCheck": {
            "command": [
              "CMD-SHELL",
              "/nodejs/bin/node -e \"fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
            ],
            "interval": 10,
            "timeout": 3,
            "retries": 3,
            "startPeriod": 20
          },
          "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
              "awslogs-group": "/ecs/taxpulse-api",
              "awslogs-region": "us-east-1",
              "awslogs-stream-prefix": "ecs"
            }
          }
        }
      ]
    },
    {
      "family": "taxpulse-compute",
      "requiresCompatibilities": [
        "FARGATE"
      ],
      "networkMode": "awsvpc",
      "cpu": "256",
      "memory": "512",
      "executionRoleArn": "arn:aws:iam::000000000000:role/taxpulse-ecs-execution",
      "taskRoleArn": "arn:aws:iam::000000000000:role/taxpulse-ecs-task",
      "containerDefinitions": [
        {
          "name": "compute",
          "image": "000000000000.dkr.ecr.us-east-1.localhost:5100/000000000000/us-east-1/taxpulse-compute:w7d1",
          "essential": true,
          "portMappings": [
            {
              "containerPort": 8000,
              "hostPort": 8000,
              "protocol": "tcp",
              "name": "http"
            }
          ],
          "environment": [
            {
              "name": "AWS_ENDPOINT_URL",
              "value": "http://floci:4566"
            },
            {
              "name": "AWS_REGION",
              "value": "us-east-1"
            },
            {
              "name": "JWT_AUDIENCE",
              "value": "taxpulse-clients"
            },
            {
              "name": "JWT_ISSUER",
              "value": "taxpulse-api"
            },
            {
              "name": "PORT",
              "value": "8000"
            }
          ],
          "healthCheck": {
            "command": [
              "CMD-SHELL",
              "/usr/bin/python3 -c \"import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status < 500 else 1)\""
            ],
            "interval": 10,
            "timeout": 3,
            "retries": 3,
            "startPeriod": 20
          },
          "logConfiguration": {
            "logDriver": "awslogs",
            "options": {
              "awslogs-group": "/ecs/taxpulse-compute",
              "awslogs-region": "us-east-1",
              "awslogs-stream-prefix": "ecs"
            }
          }
        }
      ]
    }
  ]
}
