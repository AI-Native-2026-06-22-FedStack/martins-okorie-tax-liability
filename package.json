{
  "name": "taxpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TaxPulse real-time tax-liability calculation service for wealth-advisor firms.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "ajv": "8.20.0",
    "express": "4.22.2",
    "fast-uri": "3.1.5",
    "ip-address": "10.3.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "fast-uri": "3.1.5",
    "ip-address": "10.3.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@testcontainers/postgresql": "12.0.4",
    "@types/express": "4.17.21",
    "@types/node": "20.14.15",
    "@types/pg": "8.20.0",
    "@typescript-eslint/eslint-plugin": "8.0.1",
    "@typescript-eslint/parser": "8.0.1",
    "@vitest/coverage-v8": "2.0.5",
    "eslint": "9.9.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-security": "^4.0.1",
    "pg": "8.22.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
