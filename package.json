{
  "name": "taxpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TaxPulse real-time tax-liability calculation service for wealth-advisor firms.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.14.15",
    "@typescript-eslint/eslint-plugin": "8.0.1",
    "@typescript-eslint/parser": "8.0.1",
    "eslint": "9.9.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
