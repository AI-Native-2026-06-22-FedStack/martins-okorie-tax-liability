{
  "name": "@capstone/shared-schemas",
  "version": "1.0.0",
  "description": "Versioned cross-service JSON Schema and zod contracts for TaxPulse.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
