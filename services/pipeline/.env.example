# TaxPulse pipeline and RAG environment
# Copy to `services/pipeline/.env` for local pipeline/RAG runs.

DATABASE_URL=postgresql://taxpulse_app@localhost:55433/taxpulse_l
OPENAI_API_KEY=

AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

QUARANTINE_BUCKET=taxpulse-analytics-quarantine
QUARANTINE_RATE_THRESHOLD=0.02
STAGE_CHANGED_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:taxpulse-stage-changed

WAREHOUSE_PARQUET_PATH=data/warehouse/income_rollup/**/*.parquet
PGHOST=localhost
PGPORT=55433
PGDATABASE=taxpulse_l
PGUSER=taxpulse_app
